# Copy to .env ON THE SERVER ONLY (it is gitignored) and fill in. Never commit real values.
# Generate each secret on the server; do not reuse the development ones.

# --- the image (optional) ---
# AIRFLOW_IMAGE=            # optional: leave unset to build from this repo (tag anime-airflow:local)
AIRFLOW_UID=50000

# --- Airflow ---
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
#   openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# --- the app's settings (same names as .env.local) ---
ENVIRONMENT=production
DB_URL=postgresql+asyncpg://USER:URL-ENCODED-PASSWORD@<rds-endpoint>:5432/<dbname>?ssl=require
# The pipeline never connects to Redis, but the app's settings require these to exist
REDIS_URL=redis://unused:6379/0
REDIS_BROKER_URL=redis://unused:6379/1
REDIS_BACKEND_URL=redis://unused:6379/2
JWT_SECRET=unused-by-the-pipeline
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=15
HTTP_SECURE=True
TENRAI_RATE_LIMITER_REQUESTS_PER_MINUTE=100
RESEND_API_KEY=unused-by-the-pipeline
FRONTEND_URL=https://example.invalid

# --- raw responses in S3 (ADR 0016): this server's own access key, not the laptop's ---
RAW_S3_BUCKET=
RAW_S3_PREFIX=tenrai
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
