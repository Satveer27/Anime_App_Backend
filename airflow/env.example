# Copy to airflow/.env (gitignored) and fill in. Compose reads it for ${...} substitution and
# passes every line to the containers, so the app's settings below reach the DAG tasks.

# Airflow. Generate the key with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
AIRFLOW_UID=50000

# The app's settings (same names as .env.local). Inside a container the host's Postgres/Redis
# are at host.docker.internal, not localhost.
ENVIRONMENT=local
DB_URL=postgresql+asyncpg://USER:PASSWORD@host.docker.internal:5433/anime_database
REDIS_URL=redis://host.docker.internal:6379/0
REDIS_BROKER_URL=redis://host.docker.internal:6379/1
REDIS_BACKEND_URL=redis://host.docker.internal:6379/2
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=15
HTTP_SECURE=False
TENRAI_RATE_LIMITER_REQUESTS_PER_MINUTE=100
RESEND_API_KEY=change-me
FRONTEND_URL=http://127.0.0.1:8000/api/v1/users
